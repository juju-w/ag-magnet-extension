{
  "manifest_version": 3,
  "name": "Anime Garden 磁力批量复制",
  "version": "1.0.0",
  "description": "在 animes.garden 番剧页快速按字幕组 / 集数批量复制磁力链接。",
  "action": {
    "default_title": "批量复制磁力",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["https://api.animes.garden/*"]
}
